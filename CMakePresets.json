{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "generator": "Unix Makefiles"
    },
    {
      "name": "test",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "test",
      "configurePreset": "test"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": { "outputOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "build",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build",     "name": "default" }
      ]
    },
    {
      "name": "test",
      "steps": [
        { "type": "configure", "name": "test" },
        { "type": "build",     "name": "test" },
        { "type": "test",      "name": "test" }
      ]
    }
  ]
}
